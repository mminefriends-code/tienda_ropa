# =====================================================================
# TIENDAS MONTAÑO — Configuración del backend NestJS
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a un repositorio público.
# =====================================================================

# --- Servidor ---
PORT=3000

# --- Base de datos (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# --- JWT ---
JWT_SECRET=cambia-esta-clave-por-una-larga-y-secreta
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
JWT_ALGORITHM=HS256

# --- Cookies httpOnly ---
COOKIE_SECURE=false

# --- CORS (origins del frontend) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Email (SRV_Email) ---
EMAIL_ENABLED=false
EMAIL_FROM=no-reply@tiendasmontano.com
EMAIL_BASE_URL=https://tiendasmontano.com

# =====================================================================
# Almacenamiento de ficheros
# ---------------------------------------------------------------------
# El sistema escribe en disco tres cosas: los PDF de los comprobantes,
# los respaldos de la base de datos y los reportes por voz.
#
# EN LOCAL estas rutas estan bien. En Azure App Service NO, porque el
# disco del sistema se borra en cada reinicio, despliegue y escalado.
# En la nube hay que montar un recurso compartido de archivos en
# /home/storage y apuntar las tres variables ahi:
#     STORAGE_COMPROBANTES=/home/storage/comprobantes
#     RESPALDOS_DIR=/home/storage/respaldos
#     STORAGE_PATH=/home/storage/reportes
# =====================================================================
STORAGE_BACKEND=local
STORAGE_COMPROBANTES=comprobantes
RESPALDOS_DIR=respaldos
STORAGE_PATH=./storage/reportes

# Ruta del ejecutable pg_dump. En Linux no existe y hay que dejarla
# vacia o no ponerla, porque si no el servicio de respaldos falla.
RESPALDOS_PG_DUMP_PATH=